# SOC-Lite backend configuration. Copy to `.env` (git-ignored) and adjust.
# Placeholders only: never commit real credentials or secrets.

SOC_APP_NAME=SOC-Lite
# development | test | production
SOC_ENVIRONMENT=development
SOC_DEBUG=false

# DEBUG | INFO | WARNING | ERROR | CRITICAL
SOC_LOG_LEVEL=INFO
# true = JSON lines (default); false = human-friendly console output
SOC_LOG_JSON=false

SOC_API_V1_PREFIX=/api/v1

# Comma-separated list of exact origins allowed by CORS. "*" is rejected.
# In production every origin must use https.
SOC_CORS_ALLOWED_ORIGINS=http://localhost:5173
SOC_CORS_MAX_AGE_SECONDS=600
